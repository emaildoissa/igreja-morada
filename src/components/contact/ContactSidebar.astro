---
const mapImage =
	'https://images.unsplash.com/photo-1524661135-423995f22d0b?auto=format&fit=crop&w=900&q=80';

const contactItems = [
	{
		icon: 'location_on',
		title: 'Localização',
		lines: ['Venha nos visitar', 'Cultos: Domingos às 9h e 11h'],
	},
	{
		icon: 'call',
		title: 'Telefone',
		lines: ['(00) 0000-0000'],
	},
	{
		icon: 'schedule',
		title: 'Horário do Escritório',
		lines: ['Seg — Qui / 8h – 16h'],
	},
];

const socials = [
	{ icon: 'share', label: 'Redes sociais', href: '#' },
	{ icon: 'public', label: 'Site', href: '/' },
	{ icon: 'mail', label: 'E-mail', href: 'mailto:contato@igrejamorada.org' },
];
---

<div class="flex flex-col gap-gutter md:col-span-5">
	<!-- Info card -->
	<div class="rounded-xl border border-surface-variant bg-surface-white p-stack-lg shadow-sm">
		<h3 class="mb-stack-md font-display text-2xl leading-8 text-on-background">
			Informações de Contato
		</h3>

		<div class="mt-stack-md flex flex-col gap-stack-md">
			{
				contactItems.map((item) => (
					<div class="flex items-start gap-stack-sm">
						<span class="material-symbols-outlined mt-1 text-primary-container">{item.icon}</span>
						<div>
							<h4 class="font-body text-base font-semibold leading-6 text-on-background">
								{item.title}
							</h4>
							<p class="mt-1 font-body text-base leading-6 text-on-surface-variant">
								{item.lines.map((line, i) => (
									<>
										{i > 0 && <br />}
										{line}
									</>
								))}
							</p>
						</div>
					</div>
				))
			}
		</div>

		<div class="mt-stack-lg flex gap-stack-sm border-t border-surface-variant pt-stack-md">
			{
				socials.map((social) => (
					<a
						href={social.href}
						aria-label={social.label}
						class="flex h-10 w-10 items-center justify-center rounded-full bg-surface-bright text-on-background transition-colors hover:bg-primary-container hover:text-surface-white"
					>
						<span class="material-symbols-outlined text-[20px]">{social.icon}</span>
					</a>
				))
			}
		</div>
	</div>

	<!-- Map card -->
	<a
		href="https://maps.google.com"
		target="_blank"
		rel="noopener noreferrer"
		class="group relative h-64 overflow-hidden rounded-xl border border-surface-variant bg-surface-white shadow-sm"
	>
		<img
			src={mapImage}
			alt="Mapa com a localização da Igreja Morada"
			class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
			loading="lazy"
		/>
		<div
			class="absolute inset-0 bg-on-background/10 transition-colors duration-500 group-hover:bg-transparent"
		>
		</div>
		<div
			class="absolute bottom-4 left-4 right-4 flex items-center justify-between rounded-lg border border-surface-variant bg-surface-white/90 p-3 backdrop-blur-sm"
		>
			<span class="font-body text-sm font-semibold text-on-background">Ver no Mapa</span>
			<span class="material-symbols-outlined text-primary-container">arrow_forward</span>
		</div>
	</a>
</div>
