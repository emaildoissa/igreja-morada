---
interface Props {
	active?: 'inicio' | 'sobre' | 'ministerios' | 'contribuir' | 'contato' | 'app';
}

const { active = 'inicio' } = Astro.props;

interface NavLink {
	href: string;
	label: string;
	id: 'inicio' | 'sobre' | 'ministerios' | 'contribuir' | 'contato' | 'app';
	external?: boolean;
}

const navLinks: NavLink[] = [
	{ href: '/', label: 'Início', id: 'inicio' },
	{ href: '/sobre', label: 'Sobre', id: 'sobre' },
	{ href: '/ministerios', label: 'Ministérios', id: 'ministerios' },
	{ href: '/#contribuir', label: 'Contribuir', id: 'contribuir' },
	{ href: '/contato', label: 'Contato', id: 'contato' },
	{ href: 'https://caixa-igreja-flame.vercel.app/', label: 'Acesso', id: 'app', external: true },
];
---

<header class="sticky top-0 z-50 w-full bg-surface/80 backdrop-blur-lg shadow-sm">
	<div class="mx-auto flex h-18 w-full max-w-container-max items-center justify-between px-gutter">
		<a
			href="/"
			class="flex items-center gap-3 rounded focus:outline-none focus:ring-2 focus:ring-accent"
			aria-label="Igreja Morada — início"
		>
			<img
				src="/logo.jpg"
				alt="Logo Igreja Morada"
				width="48"
				height="48"
				class="h-12 w-12 rounded-full object-cover shadow-sm ring-2 ring-accent/20"
			/>
			<span class="font-display text-2xl leading-none text-accent transition-colors duration-200 hover:text-accent-hover md:text-[28px] md:leading-9">
				Morada
			</span>
		</a>

		<nav class="hidden items-center gap-1 md:flex" aria-label="Principal">
			{
				navLinks.map((link) => {
					const isActive = link.id === active;
					return (
						<a
							href={link.href}
							target={link.external ? '_blank' : undefined}
							rel={link.external ? 'noopener noreferrer' : undefined}
							aria-current={isActive ? 'page' : undefined}
							class:list={[
								'group relative inline-flex items-center gap-1 px-4 py-2 font-body text-sm font-semibold leading-6 transition-colors duration-200',
								isActive
									? 'text-accent'
									: 'text-secondary hover:text-accent',
							]}
						>
							<span>{link.label}</span>
							{link.external && (
								<span class="material-symbols-outlined text-[16px] leading-none opacity-70 group-hover:opacity-100">
									open_in_new
								</span>
							)}
							<span
								class:list={[
									'absolute bottom-0 left-1/2 h-0.5 -translate-x-1/2 bg-accent transition-all duration-300',
									isActive ? 'w-3/4' : 'w-0 group-hover:w-3/4',
								]}
							/>
						</a>
					);
				})
			}
		</nav>

		<button
			id="menu-toggle"
			type="button"
			class="rounded p-2 text-accent focus:outline-none focus:ring-2 focus:ring-accent md:hidden"
			aria-expanded="false"
			aria-controls="mobile-menu"
			aria-label="Abrir menu"
		>
			<span class="material-symbols-outlined" data-icon-open>menu</span>
			<span class="material-symbols-outlined" data-icon-close style="display:none">close</span>
		</button>
	</div>

	<nav
		id="mobile-menu"
		class="hidden relative z-50 border-t border-surface-variant bg-surface/95 backdrop-blur-lg px-gutter py-4 md:hidden"
		aria-label="Mobile"
	>
		<ul class="flex flex-col gap-1">
			{
				navLinks.map((link) => {
					const isActive = link.id === active;
					return (
						<li>
							<a
								href={link.href}
								target={link.external ? '_blank' : undefined}
								rel={link.external ? 'noopener noreferrer' : undefined}
								aria-current={isActive ? 'page' : undefined}
								class:list={[
									'flex items-center justify-between rounded px-4 py-3 font-body text-base font-semibold transition-colors duration-200',
									isActive
										? 'bg-accent/10 text-accent'
										: 'text-secondary hover:bg-accent/5 hover:text-accent',
								]}
							>
								<span>{link.label}</span>
								{link.external && (
									<span class="material-symbols-outlined text-[18px] opacity-70">
										open_in_new
									</span>
								)}
							</a>
						</li>
					);
				})
			}
		</ul>
	</nav>
	<div id="menu-overlay" class="fixed inset-0 z-40 bg-black/40 backdrop-blur-sm hidden md:hidden" aria-hidden="true"></div>
</header>

<script>
	const toggle = document.getElementById('menu-toggle');
	const menu = document.getElementById('mobile-menu');
	const iconOpen = toggle?.querySelector<HTMLElement>('[data-icon-open]');
	const iconClose = toggle?.querySelector<HTMLElement>('[data-icon-close]');
	const overlay = document.getElementById('menu-overlay');

	function setOpen(open: boolean) {
		if (open) {
			menu?.classList.remove('hidden');
			overlay?.classList.remove('hidden');
			requestAnimationFrame(() => {
				menu?.classList.add('animate-fade-in');
			});
		} else {
			menu?.classList.add('hidden');
			menu?.classList.remove('animate-fade-in');
			overlay?.classList.add('hidden');
		}
		if (iconOpen) iconOpen.style.display = open ? 'none' : '';
		if (iconClose) iconClose.style.display = open ? '' : 'none';
		toggle?.setAttribute('aria-expanded', String(open));
		toggle?.setAttribute('aria-label', open ? 'Fechar menu' : 'Abrir menu');
	}

	toggle?.addEventListener('click', () => {
		const isOpen = toggle.getAttribute('aria-expanded') === 'true';
		setOpen(!isOpen);
	});

	overlay?.addEventListener('click', () => setOpen(false));
	
	menu?.querySelectorAll('a').forEach((link) => {
		link.addEventListener('click', () => setOpen(false));
	});
</script>