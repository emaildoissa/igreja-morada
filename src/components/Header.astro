---
interface Props {
	active?: 'inicio' | 'sobre' | 'ministerios' | 'contribuir' | 'contato';
}

const { active = 'inicio' } = Astro.props;

const navLinks = [
	{ href: '/', label: 'Início', id: 'inicio' as const },
	{ href: '/sobre', label: 'Sobre', id: 'sobre' as const },
	{ href: '/ministerios', label: 'Ministérios', id: 'ministerios' as const },
	{ href: '/#contribuir', label: 'Contribuir', id: 'contribuir' as const },
	{ href: '/contato', label: 'Contato', id: 'contato' as const },
];
---

<header class="sticky top-0 z-50 w-full bg-surface shadow-sm">
	<div class="mx-auto flex h-20 w-full max-w-container-max items-center justify-between px-gutter">
		<a
			href="/"
			class="flex items-center gap-3 rounded focus:outline-none focus:ring-2 focus:ring-primary"
			aria-label="Igreja Morada — início"
		>
			<img
				src="/logo.jpg"
				alt="Logo Igreja Morada"
				width="44"
				height="44"
				class="h-11 w-11 rounded-full object-cover shadow-sm ring-1 ring-primary/10"
			/>
			<span class="font-display text-2xl leading-none text-primary transition-colors duration-200 hover:text-primary-container md:text-[32px] md:leading-10">
				Morada
			</span>
		</a>

		<nav class="hidden items-center space-x-8 md:flex" aria-label="Principal">
			{
				navLinks.map((link) => {
					const isActive = link.id === active;
					return (
						<a
							href={link.href}
							aria-current={isActive ? 'page' : undefined}
							class:list={[
								'font-body text-base font-semibold leading-6 scale-95 transition-all duration-200 active:scale-90',
								isActive
									? 'border-b-2 border-primary pb-1 text-primary'
									: 'text-secondary hover:text-primary',
							]}
						>
							{link.label}
						</a>
					);
				})
			}
		</nav>

		<a
			href="/#contribuir"
			class="hidden items-center justify-center rounded bg-primary-container px-6 py-2.5 font-body text-base font-semibold uppercase tracking-wide text-white shadow-sm transition-all duration-300 hover:bg-primary hover:shadow-md focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 md:inline-flex"
		>
			Contribuir
		</a>

		<button
			id="menu-toggle"
			type="button"
			class="rounded p-2 text-primary focus:outline-none focus:ring-2 focus:ring-primary md:hidden"
			aria-expanded="false"
			aria-controls="mobile-menu"
			aria-label="Abrir menu"
		>
			<span class="material-symbols-outlined" data-icon-open>menu</span>
			<span class="material-symbols-outlined hidden" data-icon-close>close</span>
		</button>
	</div>

	<nav
		id="mobile-menu"
		class="hidden border-t border-surface-variant bg-surface px-gutter py-4 md:hidden"
		aria-label="Mobile"
	>
		<ul class="flex flex-col gap-1">
			{
				navLinks.map((link) => {
					const isActive = link.id === active;
					return (
						<li>
							<a
								href={link.href}
								aria-current={isActive ? 'page' : undefined}
								class:list={[
									'block rounded px-3 py-3 font-body text-base font-semibold transition-colors',
									isActive
										? 'bg-secondary-fixed text-primary'
										: 'text-secondary hover:bg-surface-container-low hover:text-primary',
								]}
							>
								{link.label}
							</a>
						</li>
					);
				})
			}
			<li class="pt-2">
				<a
					href="/#contribuir"
					class="flex w-full items-center justify-center rounded bg-primary-container px-6 py-3 font-body text-base font-semibold uppercase tracking-wide text-white transition-colors hover:bg-primary"
				>
					Contribuir
				</a>
			</li>
		</ul>
	</nav>
</header>

<script>
	const toggle = document.getElementById('menu-toggle');
	const menu = document.getElementById('mobile-menu');
	const iconOpen = toggle?.querySelector('[data-icon-open]');
	const iconClose = toggle?.querySelector('[data-icon-close]');

	function setOpen(open: boolean) {
		menu?.classList.toggle('hidden', !open);
		iconOpen?.classList.toggle('hidden', open);
		iconClose?.classList.toggle('hidden', !open);
		toggle?.setAttribute('aria-expanded', String(open));
		toggle?.setAttribute('aria-label', open ? 'Fechar menu' : 'Abrir menu');
	}

	toggle?.addEventListener('click', () => {
		const isOpen = toggle.getAttribute('aria-expanded') === 'true';
		setOpen(!isOpen);
	});

	menu?.querySelectorAll('a').forEach((link) => {
		link.addEventListener('click', () => setOpen(false));
	});
</script>
