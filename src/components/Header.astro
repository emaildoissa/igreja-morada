---
interface Props {
	active?: 'inicio' | 'sobre' | 'ministerios' | 'contribuir' | 'contato';
}

const { active = 'inicio' } = Astro.props;

const navLinks = [
	{ href: '/', label: 'Início', id: 'inicio' as const },
	{ href: '/sobre', label: 'Sobre', id: 'sobre' as const },
	{ href: '/ministerios', label: 'Ministérios', id: 'ministerios' as const },
	{ href: '/#contribuir', label: 'Contribuir', id: 'contribuir' as const },
	{ href: '/contato', label: 'Contato', id: 'contato' as const },
];
---

<header class="sticky top-0 z-50 w-full bg-surface/80 backdrop-blur-lg shadow-sm">
	<div class="mx-auto flex h-18 w-full max-w-container-max items-center justify-between px-gutter">
		<a
			href="/"
			class="flex items-center gap-3 rounded focus:outline-none focus:ring-2 focus:ring-accent"
			aria-label="Igreja Morada — início"
		>
			<img
				src="/logo.jpg"
				alt="Logo Igreja Morada"
				width="48"
				height="48"
				class="h-12 w-12 rounded-full object-cover shadow-sm ring-2 ring-accent/20"
			/>
			<span class="font-display text-2xl leading-none text-accent transition-colors duration-200 hover:text-accent-hover md:text-[28px] md:leading-9">
				Morada
			</span>
		</a>

		<nav class="hidden items-center gap-1 md:flex" aria-label="Principal">
			{
				navLinks.map((link) => {
					const isActive = link.id === active;
					return (
						<a
							href={link.href}
							aria-current={isActive ? 'page' : undefined}
							class:list={[
								'group relative px-4 py-2 font-body text-sm font-semibold leading-6 transition-colors duration-200',
								isActive
									? 'text-accent'
									: 'text-secondary hover:text-accent',
							]}
						>
							{link.label}
							<span
								class:list={[
									'absolute bottom-0 left-1/2 h-0.5 -translate-x-1/2 bg-accent transition-all duration-300',
									isActive ? 'w-3/4' : 'w-0 group-hover:w-3/4',
								]}
							/>
						</a>
					);
				})
			}
		</nav>

		<a
			href="/#contribuir"
			class="hidden items-center justify-center rounded bg-accent px-6 py-2.5 font-body text-sm font-semibold uppercase tracking-wide text-white shadow-sm transition-all duration-300 hover:bg-accent-hover hover:shadow-md focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 md:inline-flex"
		>
			Contribuir
		</a>

		<button
			id="menu-toggle"
			type="button"
			class="rounded p-2 text-accent focus:outline-none focus:ring-2 focus:ring-accent md:hidden"
			aria-expanded="false"
			aria-controls="mobile-menu"
			aria-label="Abrir menu"
		>
			<span class="material-symbols-outlined" data-icon-open>menu</span>
			<span class="material-symbols-outlined" data-icon-close style="display:none">close</span>
		</button>
	</div>

	<nav
		id="mobile-menu"
		class="hidden relative z-50 border-t border-surface-variant bg-surface/95 backdrop-blur-lg px-gutter py-4 md:hidden"
		aria-label="Mobile"
	>
		<ul class="flex flex-col gap-1">
			{
				navLinks.map((link) => {
					const isActive = link.id === active;
					return (
						<li>
							<a
								href={link.href}
								aria-current={isActive ? 'page' : undefined}
								class:list={[
									'block rounded px-4 py-3 font-body text-base font-semibold transition-colors duration-200',
									isActive
										? 'bg-accent/10 text-accent'
										: 'text-secondary hover:bg-accent/5 hover:text-accent',
								]}
							>
								{link.label}
							</a>
						</li>
					);
				})
			}
			<li class="pt-2">
				<a
					href="/#contribuir"
					class="flex w-full items-center justify-center rounded bg-accent px-6 py-3 font-body text-sm font-semibold uppercase tracking-wide text-white transition-colors hover:bg-accent-hover"
				>
					Contribuir
				</a>
			</li>
		</ul>
	</nav>
	<div id="menu-overlay" class="fixed inset-0 z-40 bg-black/40 backdrop-blur-sm hidden md:hidden" aria-hidden="true"></div>
</header>

<script>
	const toggle = document.getElementById('menu-toggle');
	const menu = document.getElementById('mobile-menu');
	const iconOpen = toggle?.querySelector('[data-icon-open]');
	const iconClose = toggle?.querySelector('[data-icon-close]');
	const overlay = document.getElementById('menu-overlay');

	function setOpen(open: boolean) {
		if (open) {
			menu?.classList.remove('hidden');
			overlay?.classList.remove('hidden');
			requestAnimationFrame(() => {
				menu?.classList.add('animate-fade-in');
			});
		} else {
			menu?.classList.add('hidden');
			menu?.classList.remove('animate-fade-in');
			overlay?.classList.add('hidden');
		}
		if (iconOpen) iconOpen.style.display = open ? 'none' : '';
		if (iconClose) iconClose.style.display = open ? '' : 'none';
		toggle?.setAttribute('aria-expanded', String(open));
		toggle?.setAttribute('aria-label', open ? 'Fechar menu' : 'Abrir menu');
	}

	toggle?.addEventListener('click', () => {
		const isOpen = toggle.getAttribute('aria-expanded') === 'true';
		setOpen(!isOpen);
	});

	overlay?.addEventListener('click', () => setOpen(false));
	
	menu?.querySelectorAll('a').forEach((link) => {
		link.addEventListener('click', () => setOpen(false));
	});
</script>