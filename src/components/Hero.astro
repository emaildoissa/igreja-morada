---
const heroImage =
	"https://images.unsplash.com/photo-1438232992991-995b7058bbb3?auto=format&fit=crop&w=1920&q=80";
const streamImage =
	"https://images.unsplash.com/photo-1516450360452-9312f5e86fc7?auto=format&fit=crop&w=800&q=80";
---

<section
	id="inicio"
	class="relative flex h-[90vh] min-h-[560px] w-full items-center overflow-hidden"
>
	<!-- Background parallax layer -->
	<div class="absolute inset-0 z-0" id="hero-parallax">
		<img
			src={heroImage}
			alt="Comunidade reunida em culto"
			class="h-full w-full object-cover"
			fetchpriority="high"
		/>
		<div
			class="absolute inset-0 bg-gradient-to-br from-[#2c2a24]/80 via-[#56533a]/70 to-[#c25b3a]/30"
		>
		</div>
	</div>

	<!-- Decorative blob -->
	<div
		class="bg-organic-blob absolute -bottom-20 -right-20 h-96 w-96 bg-accent/20"
		aria-hidden="true"
	>
	</div>

	<!-- Hero copy - left aligned -->
	<div class="relative z-10 mx-auto w-full max-w-container-max px-gutter">
		<div class="max-w-2xl">
			<span
				class="reveal mb-4 block font-body text-sm font-bold uppercase tracking-[0.15em] text-accent-soft"
			>
				Presença, pertencimento e propósito
			</span>
			<h1
				class="reveal stagger-1 font-display text-[36px] leading-[44px] text-white text-shadow-soft sm:text-[44px] sm:leading-[52px] md:text-[72px] md:leading-[80px]"
			>
				Bem-vindo à<br />Igreja Morada
			</h1>
			<p
				class="reveal stagger-2 mt-6 max-w-xl font-body text-lg leading-7 text-surface-container-low/90"
			>
				Todo mundo procura um lugar para pertencer. Nós acreditamos que
				esse lugar é onde Deus habita e pessoas se tornam família
			</p>
			<div class="reveal stagger-3 mt-8 flex flex-col gap-4 sm:flex-row">
				<a
					href="/sobre"
					class="inline-flex items-center justify-center rounded bg-accent px-8 py-4 font-body text-base font-semibold uppercase text-white shadow-md transition-all duration-300 hover:bg-accent-hover hover:shadow-lg active:scale-[0.97]"
				>
					Sou Novo Aqui
				</a>
			</div>
		</div>
	</div>

	<!-- Floating live stream card -->
	<div
		class="absolute bottom-0 left-1/2 z-20 w-[90%] max-w-3xl -translate-x-1/2 translate-y-1/2"
	>
		<div
			class="relative overflow-hidden rounded-2xl bg-white/90 backdrop-blur-md shadow-xl"
		>
			<div
				class="absolute left-0 top-0 h-full w-1.5 bg-accent"
				aria-hidden="true"
			>
			</div>
			<div
				class="flex flex-col items-center gap-6 p-6 md:flex-row md:p-8"
			>
				<div
					class="relative aspect-video w-full flex-shrink-0 overflow-hidden rounded-xl bg-surface-variant md:w-1/3"
				>
					<img
						src={streamImage}
						alt="Culto ao vivo com a comunidade em adoração"
						class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 hover:scale-105"
						loading="lazy"
					/>
				</div>
				<div
					class="flex flex-grow flex-col gap-2 text-center md:text-left"
				>
					<h3
						class="font-display text-2xl leading-8 text-on-surface md:text-[28px] md:leading-9"
					>
						Participe do Culto ao Vivo
					</h3>
					<p class="font-body text-base leading-6 text-text-muted">
						Todos os domingos às 9h e 11h
					</p>
					<div
						class="mt-3 flex flex-wrap items-center justify-center gap-4 md:justify-start"
					>
						<a
							href="#ao-vivo"
							class="inline-flex items-center justify-center rounded bg-accent px-6 py-2.5 font-body text-sm font-semibold uppercase text-white transition-all duration-300 hover:bg-accent-hover active:scale-[0.97]"
						>
							Assistir Agora
							<span
								class="material-symbols-outlined ml-2 text-[18px]"
								>arrow_forward</span
							>
						</a>
						<a
							href="#mensagens"
							class="font-body text-sm font-semibold text-secondary underline underline-offset-4 transition-colors duration-200 hover:text-accent"
						>
							Mensagens Anteriores
						</a>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>

<!-- Spacer for floating card -->
<div class="h-36 md:h-28" aria-hidden="true"></div>

<script>
	document.addEventListener("DOMContentLoaded", () => {
		if (window.innerWidth < 768) return;
		const parallax = document.getElementById("hero-parallax");
		if (!parallax) return;

		let ticking = false;
		window.addEventListener("scroll", () => {
			if (!ticking) {
				requestAnimationFrame(() => {
					const scrolled = window.scrollY;
					const speed = 0.3;
					parallax.style.transform = `translateY(${scrolled * speed}px)`;
					ticking = false;
				});
				ticking = true;
			}
		});
	});
</script>
