---
const heroImage =
	'https://images.unsplash.com/photo-1438232992991-995b7058bbb3?auto=format&fit=crop&w=1920&q=80';
const streamImage =
	'https://images.unsplash.com/photo-1516450360452-9312f5e86fc7?auto=format&fit=crop&w=800&q=80';
---

<section
	id="inicio"
	class="relative flex h-[80vh] min-h-[600px] w-full items-center justify-center overflow-hidden"
>
	<!-- Background -->
	<div class="absolute inset-0 z-0">
		<img
			src={heroImage}
			alt="Comunidade reunida em culto"
			class="h-full w-full object-cover"
			fetchpriority="high"
		/>
		<div class="absolute inset-0 bg-on-secondary-fixed/70"></div>
	</div>

	<!-- Hero copy -->
	<div class="relative z-10 mx-auto flex max-w-4xl flex-col items-center gap-stack-lg px-gutter text-center">
		<span class="font-body text-sm font-bold uppercase tracking-[0.1em] text-primary-fixed">
			Fé, Lar e Comunidade
		</span>
		<h1 class="font-display text-[40px] leading-[48px] text-white text-shadow-sm md:text-[64px] md:leading-[72px]">
			Bem-vindo à Igreja Morada
		</h1>
		<p class="max-w-2xl font-body text-lg leading-7 text-surface-container-low text-shadow-sm">
			Um lugar para pertencer, crescer e servir. Aqui você encontra uma família de fé pronta para
			caminhar com você em cada estação da vida.
		</p>
		<div class="mt-stack-sm flex flex-col gap-4 sm:flex-row">
			<a
				href="/sobre"
				class="inline-flex items-center justify-center rounded bg-primary-container px-8 py-4 font-body text-base font-semibold uppercase text-white shadow-md transition-colors duration-300 hover:bg-primary"
			>
				Sou Novo Aqui
			</a>
		</div>
	</div>

	<!-- Floating live stream card -->
	<div class="absolute bottom-0 left-1/2 z-20 w-[90%] max-w-3xl -translate-x-1/2 translate-y-1/2">
		<div class="glass-panel flex flex-col items-center gap-6 rounded-xl p-6 shadow-lg md:flex-row md:p-8">
			<div class="relative aspect-video w-full flex-shrink-0 overflow-hidden rounded-lg bg-surface-variant md:w-1/3">
				<img
					src={streamImage}
					alt="Culto ao vivo com a comunidade em adoração"
					class="absolute inset-0 h-full w-full object-cover"
					loading="lazy"
				/>
			</div>
			<div class="flex flex-grow flex-col gap-3 text-center md:text-left">
				<h3 class="font-display text-[28px] leading-9 text-on-surface md:text-[32px] md:leading-10">
					Participe do Culto ao Vivo
				</h3>
				<p class="font-body text-base leading-6 text-text-muted">
					Todos os domingos às 9h e 11h
				</p>
				<div class="mt-2 flex flex-wrap items-center justify-center gap-4 md:justify-start">
					<a
						href="#ao-vivo"
						class="inline-flex items-center justify-center rounded bg-primary-container px-6 py-2 font-body text-base font-semibold uppercase text-white transition-colors duration-300 hover:bg-primary"
					>
						Assistir Agora
						<span class="material-symbols-outlined ml-2 text-[18px]">arrow_forward</span>
					</a>
					<a
						href="#mensagens"
						class="font-body text-base font-semibold text-secondary underline underline-offset-4 transition-colors duration-200 hover:text-primary"
					>
						Mensagens Anteriores
					</a>
				</div>
			</div>
		</div>
	</div>
</section>

<!-- Spacer for floating card -->
<div class="h-32 md:h-24" aria-hidden="true"></div>
