---
const heroImage = "/fotos/acao-social.jpeg";
---

<section
	class="relative flex min-h-[360px] sm:min-h-[400px] md:min-h-[450px] w-full items-center overflow-hidden py-12 sm:py-16 md:py-20"
>
	<!-- Background parallax layer com enquadramento no topo para não cortar cabeças -->
	<div class="absolute inset-0 z-0" id="ministries-hero-parallax">
		<img
			src={heroImage}
			alt="Acolhimento e serviço comunitário na Igreja Morada"
			class="h-full w-full object-cover object-[center_0%] sm:object-[60%_0%] md:object-[70%_0%]"
			fetchpriority="high"
			loading="eager"
		/>
		<!-- Gradiente lateral para legibilidade do texto à esquerda + exibição clara das pessoas à direita -->
		<div
			class="absolute inset-0 bg-gradient-to-r from-[#2c2a24]/95 via-[#2c2a24]/75 to-transparent md:to-[#2c2a24]/25"
		>
		</div>
		<!-- Gradiente de base para transição harmoniosa com o restante da página -->
		<div
			class="absolute inset-0 bg-gradient-to-t from-[#2c2a24]/70 via-transparent to-black/20"
		>
		</div>
	</div>

	<!-- Efeito de brilho ambiente orgânico -->
	<div
		class="bg-organic-blob absolute -bottom-16 -right-16 h-80 w-80 bg-accent/25"
		aria-hidden="true"
	>
	</div>
	<div
		class="bg-organic-blob absolute -top-16 -left-16 h-80 w-80 bg-accent-soft/15"
		aria-hidden="true"
	>
	</div>

	<!-- Conteúdo textual alinhado com contraste perfeito -->
	<div class="relative z-10 mx-auto w-full max-w-container-max px-gutter">
		<div class="max-w-2xl">
			<div
				class="reveal mb-3 inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-3.5 py-1.5 backdrop-blur-md"
			>
				<span
					class="material-symbols-outlined text-[16px] text-accent-soft"
					style="font-variation-settings: 'FILL' 1"
				>
					volunteer_activism
				</span>
				<span
					class="font-body text-xs font-bold uppercase tracking-[0.15em] text-accent-soft"
				>
					Nosso Chamado
				</span>
			</div>

			<h1
				class="reveal stagger-1 font-display text-[34px] leading-[42px] text-white text-shadow-soft sm:text-[44px] sm:leading-[52px] md:text-[56px] md:leading-[64px] lg:text-[64px] lg:leading-[72px]"
			>
				Servimos nossa comunidade com amor
			</h1>

			<p
				class="reveal stagger-2 mt-4 sm:mt-5 max-w-xl font-body text-base sm:text-lg leading-relaxed text-surface-container-low/90"
			>
				Acreditamos que a fé se expressa em ação. Conheça os caminhos
				pelos quais acolhemos, cuidamos e caminhamos juntos no bairro
				Ponta Grossa.
			</p>

			<div
				class="reveal stagger-3 mt-7 flex flex-wrap items-center gap-3.5"
			>
				<a
					href="#ministerios"
					class="inline-flex items-center justify-center gap-2 rounded-xl bg-accent px-6 py-3.5 font-body text-sm font-semibold uppercase text-white shadow-md transition-all duration-300 hover:bg-accent-hover hover:shadow-lg active:scale-[0.97]"
				>
					<span>Conhecer Ministérios</span>
					<span class="material-symbols-outlined text-[18px]">
						arrow_downward
					</span>
				</a>
				<a
					href="/contato"
					class="inline-flex items-center justify-center gap-2 rounded-xl border border-white/25 bg-black/25 px-5 py-3.5 font-body text-sm font-semibold text-surface-container-low backdrop-blur-sm transition-all duration-300 hover:border-white/40 hover:bg-black/40 hover:text-white"
				>
					<span
						class="material-symbols-outlined text-[18px] text-accent-soft"
					>
						location_on
					</span>
					<span>Ponta Grossa • Av. Principal, 707</span>
				</a>
			</div>
		</div>
	</div>
</section>

<script>
	document.addEventListener("DOMContentLoaded", () => {
		if (window.innerWidth < 768) return;
		const parallax = document.getElementById("ministries-hero-parallax");
		if (!parallax) return;

		let ticking = false;
		window.addEventListener("scroll", () => {
			if (!ticking) {
				requestAnimationFrame(() => {
					const scrolled = window.scrollY;
					const speed = 0.25;
					parallax.style.transform = `translateY(${scrolled * speed}px)`;
					ticking = false;
				});
				ticking = true;
			}
		});
	});
</script>
