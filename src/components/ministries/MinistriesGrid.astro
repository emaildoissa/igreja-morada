---
const ministries = [
	{
		icon: 'church',
		title: 'Cultos Semanais',
		description:
			'Participe conosco todos os domingos de adoração, palavra prática e comunhão. Oferecemos horários que cabem na rotina da sua família.',
		cta: 'Ver horários',
		href: '/contato',
		image: 'https://images.unsplash.com/photo-1438232992991-995b7058bbb3?auto=format&fit=crop&w=600&q=80',
	},
	{
		icon: 'groups',
		title: 'Jovens',
		description:
			'Um espaço seguro para adolescentes e jovens construírem amizades, fazerem perguntas honestas e crescerem na fé com propósito.',
		cta: 'Conhecer o ministério',
		href: '/contato',
		image: 'https://images.unsplash.com/photo-1529156069898-49953e39b3ac?auto=format&fit=crop&w=600&q=80',
	},
	{
		icon: 'child_care',
		title: 'Crianças',
		description:
			'Ambientes seguros e acolhedores, por faixa etária, onde as crianças aprendem sobre o amor de Deus com histórias, brincadeiras e cuidado.',
		cta: 'Saiba mais',
		href: '/contato',
		image: 'https://images.unsplash.com/photo-1503454537195-1dcabb73ffb9?auto=format&fit=crop&w=600&q=80',
	},
	{
		icon: 'event_available',
		title: 'Eventos Especiais',
		description:
			'De encontros comunitários a celebrações sazonais — momentos pensados para reunir pessoas e celebrar a vida juntos.',
		cta: 'Ver agenda',
		href: '/contato',
		image: 'https://images.unsplash.com/photo-1464366400600-7168b8af9bc3?auto=format&fit=crop&w=600&q=80',
	},
	{
		icon: 'psychology',
		title: 'Aconselhamento',
		description:
			'Apoio pastoral confidencial e compassivo para atravessar desafios, luto, relacionamentos e outras estações difíceis da vida.',
		cta: 'Pedir apoio',
		href: '/contato',
		image: 'https://images.unsplash.com/photo-1573497620053-e3e3d6c3e6c3?auto=format&fit=crop&w=600&q=80',
	},
	{
		icon: 'volunteer_activism',
		title: 'Ação Social',
		description:
			'Atendemos necessidades práticas da comunidade com generosidade: refeições, recursos e solidariedade a quem enfrenta dificuldades.',
		cta: 'Como ajudar',
		href: '/contato',
		image: 'https://images.unsplash.com/photo-1469571486292-0ba58a3f068b?auto=format&fit=crop&w=600&q=80',
	},
];
---

<section class="relative overflow-hidden bg-surface-container-low px-gutter py-section-padding-v-mobile md:py-section-padding-v">
	<div class="absolute -left-40 bottom-0 h-80 w-80 rounded-full bg-accent-soft/20 blur-3xl" aria-hidden="true"></div>

	<div class="relative mx-auto max-w-container-max">
		<div class="reveal mx-auto mb-14 max-w-2xl text-center">
			<span class="mb-2 block font-body text-sm font-bold uppercase tracking-[0.15em] text-accent">
				Como Servimos
			</span>
			<h2 class="font-display text-[28px] leading-9 text-on-surface sm:text-[34px] sm:leading-10 md:text-[40px] md:leading-[48px]">
				Há um lugar para você
			</h2>
			<p class="mt-4 font-body text-base leading-6 text-text-muted">
				Dos cultos semanais aos programas de cuidado e ação social — cada ministério existe para
				criar comunidade, fé e esperança.
			</p>
		</div>

		<div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
			{
				ministries.map((item, i) => {
					const isLarge = i === 0 || i === 3;
					return (
						<article
							class:list={[
								'reveal group relative col-span-1 flex h-full flex-col overflow-hidden rounded-2xl bg-surface-container-lowest shadow-sm transition-all duration-500 hover:-translate-y-1 hover:shadow-lg',
								isLarge ? 'md:col-span-2 lg:col-span-1' : '',
								i === 0 ? 'stagger-1' : i === 1 ? 'stagger-2' : i === 2 ? 'stagger-3' : i === 3 ? 'stagger-4' : i === 4 ? 'stagger-5' : 'stagger-5',
							]}
						>
							<div class="relative h-36 w-full overflow-hidden">
								<div class="absolute inset-0 bg-gradient-to-t from-surface-container-lowest/70 via-transparent to-transparent z-10"></div>
								<img
									src={item.image}
									alt=""
									class="h-full w-full object-cover transition-all duration-700 group-hover:scale-110 group-hover:saturate-[1.1]"
									loading="lazy"
								/>
							</div>
							<div class="relative z-20 -mt-8 flex flex-col gap-3 p-5 pt-0">
								<div class="flex h-11 w-11 items-center justify-center rounded-xl bg-accent text-white shadow-md transition-transform duration-300 group-hover:scale-110">
									<span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1">{item.icon}</span>
								</div>
								<h3 class="font-display text-xl leading-7 text-on-surface">
									{item.title}
								</h3>
								<p class="flex-grow font-body text-sm leading-6 text-text-muted">
									{item.description}
								</p>
								<a
									href={item.href}
									class="mt-2 inline-flex w-fit items-center gap-2 font-body text-sm font-semibold text-accent transition-all duration-300 hover:text-accent-hover"
								>
									{item.cta}
									<span class="material-symbols-outlined text-[16px] transition-transform duration-300 group-hover:translate-x-1">arrow_forward</span>
								</a>
							</div>
						</article>
					);
				})
			}
		</div>
	</div>
</section>