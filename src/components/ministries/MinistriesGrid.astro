---
const ministries = [
	{
		icon: 'church',
		title: 'Cultos Semanais',
		description:
			'Participe conosco todos os domingos de adoração, palavra prática e comunhão. Oferecemos horários que cabem na rotina da sua família.',
		cta: 'Ver horários',
		href: '/contato',
	},
	{
		icon: 'groups',
		title: 'Jovens',
		description:
			'Um espaço seguro para adolescentes e jovens construírem amizades, fazerem perguntas honestas e crescerem na fé com propósito.',
		cta: 'Conhecer o ministério',
		href: '/contato',
	},
	{
		icon: 'child_care',
		title: 'Crianças',
		description:
			'Ambientes seguros e acolhedores, por faixa etária, onde as crianças aprendem sobre o amor de Deus com histórias, brincadeiras e cuidado.',
		cta: 'Saiba mais',
		href: '/contato',
	},
	{
		icon: 'event_available',
		title: 'Eventos Especiais',
		description:
			'De encontros comunitários a celebrações sazonais — momentos pensados para reunir pessoas e celebrar a vida juntos.',
		cta: 'Ver agenda',
		href: '/contato',
	},
	{
		icon: 'psychology',
		title: 'Aconselhamento',
		description:
			'Apoio pastoral confidencial e compassivo para atravessar desafios, luto, relacionamentos e outras estações difíceis da vida.',
		cta: 'Pedir apoio',
		href: '/contato',
	},
	{
		icon: 'volunteer_activism',
		title: 'Ação Social',
		description:
			'Atendemos necessidades práticas da comunidade com generosidade: refeições, recursos e solidariedade a quem enfrenta dificuldades.',
		cta: 'Como ajudar',
		href: '/contato',
	},
];
---

<section class="bg-surface-container-low px-gutter py-section-padding-v-mobile md:py-section-padding-v">
	<div class="mx-auto max-w-container-max">
		<div class="mx-auto mb-section-padding-v-mobile max-w-2xl text-center">
			<span class="mb-2 block font-body text-sm font-bold uppercase tracking-[0.1em] text-primary">
				Como Servimos
			</span>
			<h2 class="mb-4 font-display text-[32px] leading-10 text-on-surface">
				Há um lugar para você
			</h2>
			<p class="font-body text-base leading-6 text-text-muted">
				Dos cultos semanais aos programas de cuidado e ação social — cada ministério existe para
				criar comunidade, fé e esperança.
			</p>
		</div>

		<div class="grid grid-cols-1 gap-stack-lg md:grid-cols-2 lg:grid-cols-3">
			{
				ministries.map((item) => (
					<article class="group flex h-full flex-col rounded-xl border border-surface-variant bg-surface-container-lowest p-stack-lg shadow-[0_4px_20px_rgba(0,0,0,0.03)] transition-all duration-300 hover:shadow-[0_8px_30px_rgba(0,0,0,0.06)]">
						<div class="mb-stack-md flex h-12 w-12 items-center justify-center rounded-lg bg-secondary-fixed text-on-secondary-fixed transition-colors group-hover:bg-primary-container group-hover:text-white">
							<span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1">
								{item.icon}
							</span>
						</div>
						<h3 class="mb-stack-sm font-display text-2xl leading-8 text-on-surface">
							{item.title}
						</h3>
						<p class="mb-stack-md flex-grow font-body text-base leading-6 text-text-muted">
							{item.description}
						</p>
						<a
							href={item.href}
							class="mt-auto inline-flex w-fit items-center gap-2 font-body text-base font-semibold text-primary transition-colors hover:text-primary-container"
						>
							{item.cta}
							<span class="material-symbols-outlined text-[18px]">arrow_forward</span>
						</a>
					</article>
				))
			}
		</div>
	</div>
</section>
