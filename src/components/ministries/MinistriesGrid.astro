---
const ministries = [
	{
		icon: "church",
		title: "Culto da Família",
		schedule: "Domingos às 19:30",
		description:
			"Um tempo especial para adorar em família, ouvir a Palavra de Deus e viver comunhão genuína. Um ambiente onde você e seus entes queridos encontram lar e renovo espiritual.",
		cta: "Como participar",
		href: "/contato",
		image: "/fotos/culto-da-familia.jpeg",
		imagePosition: "object-[50%_50%]",
	},
	{
		icon: "groups",
		title: "Morada YouTh (Jovens)",
		schedule: "Sábados às 20:00",
		description:
			"Jesus no centro, propósito e amizade verdadeira. O Morada YouTh reúne jovens para viver a fé de forma viva e prática, construindo conexões que transformam vidas.",
		cta: "Conhecer o YouTh",
		href: "/contato",
		image: "/fotos/morada-youth.jpeg",
		imagePosition: "object-[45%_35%]",
	},
	{
		icon: "favorite",
		title: "Culto de Oração",
		schedule: "Terças às 20:00",
		description:
			"Momento reservado para busca, intercessão e clamor coletivo. Acreditamos no poder da oração para transformar corações, famílias e a nossa comunidade.",
		cta: "Orar conosco",
		href: "/contato",
		image: "/fotos/culto-de-oracao.jpeg",
		imagePosition: "object-[50%_35%]",
	},
	{
		icon: "home",
		title: "Células nos Lares",
		schedule: "Quintas e Sextas",
		description:
			"A igreja presente nas casas: pequenos grupos de comunhão, estudo da Palavra, cuidado mútuo e amizade profunda no dia a dia da nossa comunidade.",
		cta: "Encontrar uma célula",
		href: "/contato",
		image: "/fotos/Celulas-nos-Lares.jpeg",
		imagePosition: "object-[50%_25%]",
	},
	{
		icon: "psychology",
		title: "Aconselhamento Pastoral",
		schedule: "Agendamento com a Pastoral",
		description:
			"Ninguém precisa atravessar momentos difíceis sozinho. Atendimento pastoral e oração com a Pastora Glaci (51 98450-7678) e o Pastor Claudiomir (51 98643-7273).",
		cta: "Falar com pastores",
		href: "/contato",
		image: "/fotos/aconselhamento-pastoral.jpeg",
		imagePosition: "object-[50%_35%]",
	},
	{
		icon: "child_care",
		title: "Ministério Infantil (Crianças)",
		schedule: "Durante os cultos",
		description:
			"Um ambiente seguro, alegre e acolhedor onde cada criança aprende a Palavra de Deus de forma dinâmica e cresce cercada de carinho e proteção.",
		cta: "Saiba mais",
		href: "/contato",
		image: "/fotos/kids-morada.jpeg",
		imagePosition: "object-[50%_30%]",
	},
	{
		icon: "volunteer_activism",
		title: "Ação Social",
		schedule: "Projetos e Ações Comunitárias",
		description:
			"A fé que vivemos alcança o bairro Ponta Grossa. Estendemos a mão a quem precisa com acolhimento, mantimentos e apoio à comunidade.",
		cta: "Como apoiar",
		href: "/contato",
		image: "/fotos/acao-social.jpeg",
		imagePosition: "object-[50%_25%]",
	},
];
---

<section
	class="relative overflow-hidden bg-surface-container-low px-gutter py-section-padding-v-mobile md:py-section-padding-v"
>
	<div
		class="absolute -left-40 bottom-0 h-80 w-80 rounded-full bg-accent-soft/20 blur-3xl"
		aria-hidden="true"
	>
	</div>

	<div class="relative mx-auto max-w-container-max">
		<div class="reveal mx-auto mb-14 max-w-2xl text-center">
			<span
				class="mb-2 block font-body text-sm font-bold uppercase tracking-[0.15em] text-accent"
			>
				Como Servimos
			</span>
			<h2
				class="font-display text-[28px] leading-9 text-on-surface sm:text-[34px] sm:leading-10 md:text-[40px] md:leading-[48px]"
			>
				Há um lugar para você na Morada
			</h2>
			<p class="mt-4 font-body text-base leading-6 text-text-muted">
				Somos um só corpo e uma só família no bairro Ponta Grossa. Descubra os nossos encontros semanais,
				células nos lares e ministérios onde você pode crescer, servir e viver o propósito de Deus.
			</p>
		</div>

		<div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
			{
				ministries.map((item, i) => {
					return (
						<article
							class:list={[
								"reveal group relative col-span-1 flex h-full flex-col overflow-hidden rounded-2xl bg-surface-container-lowest shadow-sm transition-all duration-500 hover:-translate-y-1 hover:shadow-lg",
								i === 0
									? "stagger-1"
									: i === 1
										? "stagger-2"
										: i === 2
											? "stagger-3"
											: i === 3
												? "stagger-4"
												: "stagger-5",
							]}
						>
							<div class="relative h-36 w-full overflow-hidden">
								<div class="absolute inset-0 bg-gradient-to-t from-surface-container-lowest/70 via-transparent to-transparent z-10" />
								<img
									src={item.image}
									alt={item.title}
									class:list={[
										"h-full w-full object-cover transition-all duration-700 group-hover:scale-110 group-hover:saturate-[1.1]",
										item.imagePosition || "object-center",
									]}
									loading="lazy"
								/>
								{item.schedule && (
									<span class="absolute top-3 right-3 z-20 rounded-full bg-[#2c2a24]/85 px-3 py-1 font-body text-xs font-semibold text-accent-soft backdrop-blur-sm shadow-sm">
										{item.schedule}
									</span>
								)}
							</div>
							<div class="relative z-20 -mt-8 flex flex-col gap-3 p-5 pt-0 flex-grow">
								<div class="flex h-11 w-11 items-center justify-center rounded-xl bg-accent text-white shadow-md transition-transform duration-300 group-hover:scale-110">
									<span
										class="material-symbols-outlined text-[22px]"
										style="font-variation-settings: 'FILL' 1"
									>
										{item.icon}
									</span>
								</div>
								<h3 class="font-display text-xl leading-7 text-on-surface">
									{item.title}
								</h3>
								<p class="flex-grow font-body text-sm leading-6 text-text-muted">
									{item.description}
								</p>
								<div class="pt-2 border-t border-surface-variant/40 mt-auto">
									<a
										href={item.href}
										class="inline-flex w-fit items-center gap-2 font-body text-sm font-semibold text-accent transition-all duration-300 hover:text-accent-hover"
									>
										<span>{item.cta || "Saiba mais"}</span>
										<span class="material-symbols-outlined text-[16px] transition-transform duration-300 group-hover:translate-x-1">
											arrow_forward
										</span>
									</a>
								</div>
							</div>
						</article>
					);
				})
			}
		</div>
	</div>
</section>
