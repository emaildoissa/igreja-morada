---
const beliefs = [
	{
		title: 'Jesus é Senhor',
		description:
			'Confessamos Jesus Cristo como Senhor e Salvador — o centro da nossa fé, adoração e vida em comunidade.',
		image:
			'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=800&q=80',
		alt: 'Pessoas em adoração durante o culto',
		accent: '#c25b3a',
	},
	{
		title: 'Deus é Amor',
		description:
			'Cremos que o amor de Deus transforma vidas e nos chama a acolher, servir e caminhar juntos com graça.',
		image:
			'https://images.unsplash.com/photo-1504052434569-70ad5836ab65?auto=format&fit=crop&w=800&q=80',
		alt: 'Bíblia aberta em momento de devoção',
		accent: '#e8c9a0',
	},
	{
		title: 'O Espírito Capacita',
		description:
			'O Espírito Santo nos guia, consola e capacita para viver o evangelho com coragem, união e propósito.',
		image:
			'https://images.unsplash.com/photo-1490730141103-6cac27aaab94?auto=format&fit=crop&w=800&q=80',
		alt: 'Pessoa em momento de oração e contemplação',
		accent: '#6b7d53',
	},
];
---

<section class="relative overflow-hidden bg-surface px-gutter py-section-padding-v-mobile md:py-section-padding-v">
	<div class="absolute -right-32 top-0 h-72 w-72 rounded-full bg-accent-soft/20 blur-3xl" aria-hidden="true"></div>

	<div class="relative mx-auto max-w-container-max">
		<div class="reveal mx-auto mb-14 max-w-2xl text-center">
			<span class="mb-2 block font-body text-sm font-bold uppercase tracking-[0.15em] text-accent">
				Tudo Sobre Jesus
			</span>
			<h2 class="font-display text-[28px] leading-9 text-on-background sm:text-[34px] sm:leading-10 md:text-[40px] md:leading-[48px]">
				No que Cremos
			</h2>
			<p class="mt-4 font-body text-base leading-6 text-text-muted">
				Nossa fé é simples e profunda: Jesus no centro, a Palavra como fundamento e o amor como
				prática diária em comunidade.
			</p>
		</div>

		<div class="grid grid-cols-1 gap-6 md:grid-cols-3">
			{
				beliefs.map((belief, i) => (
					<article
						class:list={[
							'reveal group relative flex flex-col overflow-hidden rounded-2xl bg-surface-container-lowest shadow-sm transition-all duration-500 hover:-translate-y-1 hover:shadow-lg',
							i === 0 ? 'stagger-1' : i === 1 ? 'stagger-2' : 'stagger-3',
						]}
					>
						<div class="relative h-52 w-full overflow-hidden">
							<div class="absolute inset-0 bg-gradient-to-t from-surface-container-lowest/80 via-transparent to-transparent z-10"></div>
							<img
								src={belief.image}
								alt={belief.alt}
								class="h-full w-full object-cover transition-all duration-700 group-hover:scale-110 group-hover:saturate-[1.1]"
								loading="lazy"
							/>
						</div>
						<div class="relative z-20 -mt-10 flex flex-col gap-3 p-6 pt-0">
							<div
								class="flex h-14 w-14 items-center justify-center rounded-2xl shadow-md transition-transform duration-300 group-hover:scale-110"
								style={`background-color: ${belief.accent}`}
							>
								<span class="font-display text-xl font-bold text-white">
									{i === 0 ? '✠' : i === 1 ? '♡' : '✦'}
								</span>
							</div>
							<h3 class="font-display text-xl leading-7 text-on-background">
								{belief.title}
							</h3>
							<p class="font-body text-sm leading-6 text-text-muted">{belief.description}</p>
						</div>
					</article>
				))
			}
		</div>

		<div class="reveal stagger-3 mt-12 text-center">
			<a
				href="/contato"
				class="inline-flex items-center justify-center rounded border-2 border-accent bg-transparent px-8 py-3 font-body text-sm font-semibold uppercase text-accent transition-all duration-300 hover:bg-accent hover:text-white active:scale-[0.97]"
			>
				Saiba Mais Sobre Nossa Fé
			</a>
		</div>
	</div>
</section>