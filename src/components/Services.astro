---
const services = [
	{
		icon: 'menu_book',
		title: 'Cultos Semanais',
		description: 'Encontros de adoração, palavra e comunhão para toda a família.',
		image: 'https://images.unsplash.com/photo-1438232992991-995b7058bbb3?auto=format&fit=crop&w=600&q=80',
	},
	{
		icon: 'groups',
		title: 'Jovens',
		description: 'Um espaço seguro para crescer na fé, amizades e propósito.',
		image: 'https://images.unsplash.com/photo-1529156069898-49953e39b3ac?auto=format&fit=crop&w=600&q=80',
	},
	{
		icon: 'child_care',
		title: 'Crianças',
		description: 'Ministério infantil com cuidado, brincadeiras e ensino bíblico.',
		image: 'https://images.unsplash.com/photo-1503454537195-1dcabb73ffb9?auto=format&fit=crop&w=600&q=80',
	},
];
---

<section
	id="ministerios"
	class="relative overflow-hidden bg-surface px-gutter py-section-padding-v-mobile md:py-section-padding-v"
>
	<div class="absolute -left-40 top-1/2 h-80 w-80 rounded-full bg-accent-soft/30 blur-3xl" aria-hidden="true"></div>

	<div class="relative mx-auto max-w-container-max">
		<div class="reveal mx-auto mb-14 max-w-2xl text-center">
			<span class="mb-2 block font-body text-sm font-bold uppercase tracking-[0.15em] text-accent">
				Nossos Ministérios
			</span>
			<h2 class="font-display text-[34px] leading-10 text-on-surface md:text-[40px] md:leading-[48px]">
				Servindo nossa comunidade<br />com amor
			</h2>
			<p class="mt-4 font-body text-base leading-6 text-text-muted">
				Acreditamos que cada pessoa tem um lugar e um chamado. Conheça alguns dos caminhos pelos
				quais caminhamos juntos como igreja.
			</p>
		</div>

		<div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
			{
				services.map((service, i) => (
					<article
						class:list={[
							'reveal group relative flex flex-col overflow-hidden rounded-2xl bg-surface-container-lowest transition-all duration-500 hover:-translate-y-1',
							i === 0 ? 'stagger-1' : i === 1 ? 'stagger-2' : 'stagger-3',
						]}
					>
						<div class="relative h-40 w-full overflow-hidden">
							<div class="absolute inset-0 bg-gradient-to-t from-surface-container-lowest via-transparent to-transparent z-10"></div>
							<img
								src={service.image}
								alt=""
								class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-110"
								loading="lazy"
							/>
						</div>
						<div class="relative z-20 -mt-8 flex flex-col gap-3 p-6 pt-0">
							<div class="flex h-12 w-12 items-center justify-center rounded-xl bg-accent text-white shadow-md transition-colors group-hover:bg-accent-hover">
								<span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1">{service.icon}</span>
							</div>
							<div>
								<h3 class="font-display text-xl leading-7 text-on-surface">
									{service.title}
								</h3>
								<p class="mt-1.5 font-body text-sm leading-6 text-text-muted">{service.description}</p>
							</div>
						</div>
					</article>
				))
			}
		</div>

		<div class="reveal stagger-3 mt-12 text-center">
			<a
				href="/ministerios"
				class="inline-flex items-center justify-center rounded border-2 border-accent bg-transparent px-8 py-3 font-body text-sm font-semibold uppercase text-accent transition-all duration-300 hover:bg-accent hover:text-white active:scale-[0.97]"
			>
				Ver Todos os Ministérios
			</a>
		</div>
	</div>
</section>