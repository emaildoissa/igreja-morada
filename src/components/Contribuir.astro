---
---

<section
	id="contribuir"
	class="relative overflow-hidden bg-surface-container-low px-gutter py-section-padding-v-mobile md:py-section-padding-v"
>
	<div class="absolute -right-40 top-1/2 h-80 w-80 rounded-full bg-accent/10 blur-3xl" aria-hidden="true"></div>

	<div class="relative mx-auto max-w-container-max">
		<div class="reveal mx-auto mb-12 max-w-2xl text-center">
			<span class="mb-2 block font-body text-sm font-bold uppercase tracking-[0.15em] text-accent">
				Contribua
			</span>
			<h2 class="font-display text-[34px] leading-10 text-on-surface md:text-[40px] md:leading-[48px]">
				Faça parte desta missão
			</h2>
			<p class="mt-4 font-body text-base leading-6 text-text-muted">
				Sua contribuição nos ajuda a manter nossa comunidade viva, acolhendo pessoas,
				cuidando de famílias e levando esperança a quem precisa.
			</p>
		</div>

		<div class="grid grid-cols-1 gap-6 md:grid-cols-3">
			<div class="reveal stagger-1 rounded-2xl bg-surface-white p-6 sm:p-8 shadow-sm text-center">
				<div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-2xl bg-accent/10 text-accent">
					<span class="material-symbols-outlined text-2xl" style="font-variation-settings: 'FILL' 1">volunteer_activism</span>
				</div>
				<h3 class="mb-2 font-display text-xl leading-7 text-on-surface">Presencial</h3>
				<p class="font-body text-sm leading-6 text-text-muted">
					Participe dos nossos cultos e traga sua oferta. Toda contribuição é bem-vinda e faz diferença.
				</p>
			</div>

			<div class="reveal stagger-2 rounded-2xl bg-surface-white p-6 sm:p-8 shadow-sm text-center">
				<div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-2xl bg-accent/10 text-accent">
					<span class="material-symbols-outlined text-2xl" style="font-variation-settings: 'FILL' 1">payments</span>
				</div>
				<h3 class="mb-2 font-display text-xl leading-7 text-on-surface">PIX</h3>
				<p class="font-body text-sm leading-6 text-text-muted">
					Transfira via PIX para a chave da igreja. Rápido, seguro e sem taxas.
				</p>
			</div>

			<div class="reveal stagger-3 rounded-2xl bg-surface-white p-6 sm:p-8 shadow-sm text-center">
				<div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-2xl bg-accent/10 text-accent">
					<span class="material-symbols-outlined text-2xl" style="font-variation-settings: 'FILL' 1">qr_code_scanner</span>
				</div>
				<h3 class="mb-2 font-display text-xl leading-7 text-on-surface">QR Code</h3>
				<p class="font-body text-sm leading-6 text-text-muted">
					Escaneie o QR Code disponível nos cultos ou peça pelo nosso contato.
				</p>
			</div>
		</div>

		<div class="reveal stagger-3 mt-10 text-center">
			<a
				href="/contato"
				class="inline-flex items-center justify-center rounded-xl bg-accent px-8 py-3.5 font-body text-sm font-semibold uppercase text-white shadow-sm transition-all duration-300 hover:bg-accent-hover hover:shadow-md active:scale-[0.97]"
			>
				Fale Conosco
				<span class="material-symbols-outlined ml-2 text-[18px]">arrow_forward</span>
			</a>
		</div>
	</div>
</section>
